#!name=南网在线95598_Token获取
#!desc=打开南网在线App或微信小程序自动捕获x-auth-token
#!author=95du (维护: string2json)
#!loon_version=3.5.1(983)
#!date=2026-10-16
#!tag=95598,南网在线,电网,token

############################################################
# 使用方式:
#   1. 安装并信任 Loon MitM 根证书
#   2. 开启 MitM(plugin 自动配置 hostname)
#   3. 打开南网在线 App 或 微信小程序 → 登录 → 进入首页
#   4. Loon 通知栏出现 "南网在线 / 95598_Token 获取成功" 即成功
#
# 触发原理:
#   匹配 queryBindEleUsers 请求,从 request header 中读取 x-auth-token
#   微信小程序走 weixin.csg.cn,App 走 95598.csg.cn
#
# Token 存储位置:
#   Loon 持久化存储 key = "token_95598"
#
# 脚本来源:
#   https://github.com/95du/scripts/blob/master/rewrite/get_95598_token.js
#   已同步到本仓库 rewrite/95598/get_95598_token.js 便于维护
#
# 2026-10-16 修复:
#   1. 漏匹配 weixin.csg.cn (微信小程序实际域名)
#   2. [Rewrite] + script-request-header 是 Surge 旧语法,
#      Loon plugin 要用 [Script] + http-request
############################################################

[Script]
http-request ^https:\/\/(95598|weixin)\.csg\.cn script-path=https://raw.githubusercontent.com/string2json/scriptable-collection/main/rewrite/95598/get_95598_token.js, tag=95598Token

[Mitm]
hostname = 95598.csg.cn, weixin.csg.cn
