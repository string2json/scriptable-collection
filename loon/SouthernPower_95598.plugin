#!name=南网在线95598_Token获取
#!desc=打开南网在线App自动捕获x-auth-token
#!author=95du (维护: string2json)
#!loon_version=3.5.1(983)
#!date=2026-10-16
#!tag=95598,南网在线,电网,token

############################################################
# 使用方式:
#   1. 安装并信任 Loon MitM 根证书
#   2. 开启 MitM(plugin 自动配置 hostname)
#   3. 打开南网在线 App → 登录 → 进入首页(触发 queryBindEleUsers 接口)
#   4. Loon 通知栏出现 "南网在线 / 95598_Token 获取成功" 即成功
#
# 触发原理:
#   匹配 https://95598.csg.cn 请求,从 request header 中读取 x-auth-token
#
# Token 存储位置:
#   Loon 持久化存储 key = "token_95598"
#
# 脚本来源:
#   https://github.com/95du/scripts/blob/master/rewrite/get_95598_token.js
#   已同步到本仓库 rewrite/95598/get_95598_token.js 便于维护
############################################################

[Rewrite]
^https:\/\/95598\.csg\.cn url script-request-header https://raw.githubusercontent.com/string2json/scriptable-collection/main/rewrite/95598/get_95598_token.js

[Mitm]
hostname = 95598.csg.cn
