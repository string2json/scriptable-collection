#!name=马上充小程序去广告
#!desc=针对佛山商捷"马上充"充电小程序的广告拦截
#!author=LocalDev
#!loon_version=3.5.1(983)
#!date=2026-10-14
#!tag=去广告,马上充,商捷,充电

############################################################
# HAR 抓包确认:
# 广告平台 = 易电联(yidianlingyi.cn)
#   api.yidianlingyi.cn//adpp/api/universalAdQuery → 拉广告数据(JSON)
#   api.yidianlingyi.cn//adpp/api/ad/exposure → 广告曝光上报
#   image.yidianlingyi.cn/adpp/images/bannermage/ → 广告图片资源
#
# 拦截策略:
#   1. api.yidianlingyi.cn → REJECT-DICT,请求被拒绝,返回空JSON
#      这样小程序拿不到广告数据,就不会去加载图片
#   2. image.yidianlingyi.cn → REJECT-IMG,保险兜底
#   3. 腾讯统一域名(防切换广告组件)
#
# 不需要 MitM,DNS 层面直接拦截
############################################################

[Rule]

# ═══ 第一层:腾讯统一广告域名(防它后续切换) ═══
DOMAIN, wxa.wxs.qq.com, REJECT-DICT
DOMAIN, wximg.wxs.qq.com, REJECT-DICT
DOMAIN, wxsmw.wxs.qq.com, REJECT-DICT
DOMAIN, wxsnsdy.wxs.qq.com, REJECT
DOMAIN, wxsnsdythumb.wxs.qq.com, REJECT
DOMAIN, wxsmsdy.video.qq.com, REJECT

# ═══ 第二层:马上充广告主域名(DNS层拦截,核心) ═══
# 广告数据查询 + 曝光上报,拦了就没广告数据
DOMAIN, api.yidianlingyi.cn, REJECT-DICT

# ═══ 第三层:保险兜底(广告图片资源) ═══
DOMAIN, image.yidianlingyi.cn, REJECT-IMG
URL-REGEX, "^https?://[^/]*yidianlingyi\.cn/adpp/", REJECT-DICT
