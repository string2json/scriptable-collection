#!name=粤语翻译神器解锁会员
#!desc=粤语翻译神器 AppStore 订阅校验伪造
#!author=ios151 (维护: string2json)
#!icon=https://raw.githubusercontent.com/string2json/scriptable-collection/main/img/yyfysq.png
#!date=2026-10-16
#!tag=粤语,翻译神器,会员

############################################################
# 使用方式:
#   1. 安装并信任 Loon MitM 根证书
#   2. 开启 MitM(plugin 自动配置 hostname)
#   3. 打开粤语翻译神器 App → 登录 → 进入会员页面
#   4. 自动解锁终身 VIP
#
# 原理:
#   App 请求 /apple_product/ 查询 AppStore 订阅状态,
#   脚本拦截响应,伪造终身订阅(vip_lifetime,expires=2099)
#   这是 iOS App 的通用破解套路:后端走自建 API 转发 AppStore 校验,
#   直接在服务端 API 层返回伪造响应就能绕过验证。
#
# 脚本来源:
#   https://github.com/ios151/Rewrite/blob/main/yyfysq.js
#   已同步到本仓库 rewrite/ios151/yyfysq.js 便于维护
#
# 2026-10-16 维护:
#   从 Surge rewrite_local 语法适配为 Loon [Script] plugin
#   所有资源迁移本仓库
############################################################

[Script]
http-response ^http:\/\/api\.528529\.com\/apple_product\/ script-path=https://raw.githubusercontent.com/string2json/scriptable-collection/main/rewrite/ios151/yyfysq.js, requires-body=true, tag=粤语翻译解锁

[Mitm]
hostname = api.528529.com
