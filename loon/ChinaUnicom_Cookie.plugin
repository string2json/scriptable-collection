#!name=中国联通Cookie获取
#!desc=打开联通App首页流量查询自动捕获Cookie
#!author=dompling (维护: string2json)
#!loon_version=3.5.1(983)
#!date=2026-10-16
#!tag=联通,10010,cookie

############################################################
# 使用方式:
#   1. 安装并信任 Loon MitM 根证书
#   2. 开启 MitM(plugin 自动配置 hostname)
#   3. 打开中国联通 App 【官方版】→ 首页 → 流量查询
#   4. Loon 通知栏出现 "中国联通 / cookie 写入成功" 即成功
#
# Cookie 存储位置:
#   Loon 持久化存储 key = "YaYa_10010",内部 key = "cookie"
#
# 脚本来源:
#   https://github.com/dompling/Script/blob/master/10010/index.js
#   已同步到本仓库 rewrite/10010/index.js 便于维护
#
# 2026-10-16 修复:
#   [Rewrite] + script-request-header 是 Surge 旧语法,Loon plugin 要用 [Script] + http-request
############################################################

[Script]
http-request ^https?:\/\/m(?:xx)?\.client\.10010\.com\/(?:.*\/)?smartwisdomCommon(?:New)?(?:\?.*)?$ script-path=https://raw.githubusercontent.com/string2json/scriptable-collection/main/rewrite/10010/index.js, tag=联通headers

[Mitm]
hostname = m.client.10010.com, mxx.client.10010.com
