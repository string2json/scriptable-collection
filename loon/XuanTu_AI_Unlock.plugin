#!name=炫图AI画图解锁会员
#!desc=自动注册+解锁AI功能+无水印
#!author=ios151 (维护: string2json)
#!icon=https://raw.githubusercontent.com/string2json/scriptable-collection/main/img/xuantu.png
#!loon_version=3.5.1(983)
#!date=2026-10-16
#!tag=炫图,xuantu,AI,画图

############################################################
# 原理:
#   xt.js  → 匹配 /creation/myworks,自动注册临时邮箱+验证码登录拿 token
#   xt2.js → 匹配会员/生成相关 API,把 token 注入请求头
#   xt3.js → 匹配 /user/getUserInfo,伪造已登录的 userInfo 响应
#
# 功能:
#   ✅ AI 画图无次数限制
#   ✅ 解锁会员功能
#   ✅ 无水印导出
#
# 使用:
#   1. 安装并信任 Loon MitM 根证书
#   2. 开启 MitM(plugin 会自动配置 hostname)
#   3. 打开炫图 App → 微信登录 → 进入个人页面
#   4. Loon 日志出现 "✅ 登录成功" 即成功
#
# 2026-10-16 v2 修复(关键):
#   ❌ 之前 regex ^https:\/\/xuantu\.pro\/ 匹配不到实际请求
#   ✅ 所有请求走 api.xuantu.pro,已改成 ^https:\/\/api\.xuantu\.pro\/
#   新增 App 2.3.51 的路径:/vip/options/meals/v2 等
############################################################

[Script]
# 触发自动注册拿 token(每次进"我的作品"都执行)
http-request ^https:\/\/api\.xuantu\.pro\/creation\/myworks script-path=https://raw.githubusercontent.com/string2json/scriptable-collection/main/rewrite/ios151/xt.js, tag=炫图触发

# 注入 token 解锁会员功能(覆盖生成/会员/图片/STS 等)
http-request ^https:\/\/api\.xuantu\.pro\/(creation\/(generate\/(v2|v3)|memberships|getProgress|imageintent)|file\/aliyun\/sts|community\/comment\/pub|vip\/) script-path=https://raw.githubusercontent.com/string2json/scriptable-collection/main/rewrite/ios151/xt2.js, tag=炫图注入

# 伪造已登录状态(个人中心显示会员)
# 必须 requires-body=true,否则 $response.body 是 undefined(Loon 官方文档要求)
http-response ^https:\/\/api\.xuantu\.pro\/user\/getUserInfo script-path=https://raw.githubusercontent.com/string2json/scriptable-collection/main/rewrite/ios151/xt3.js, requires-body=true, tag=炫图伪造

[Rewrite]
# 无水印:去掉 ReplaceBackgroundWithPrompt 路径里的尺寸参数
^http:\/\/statica\.xuantu\.pro\/x\/prod\/ReplaceBackgroundWithPrompt\/(\d+-\d+)\.jpg\?.* url 302 http:\/\/statica\.xuantu\.pro\/x\/prod\/ReplaceBackgroundWithPrompt\/$1.jpg

[Mitm]
hostname = api.xuantu.pro, xuantu.pro, statica.xuantu.pro
