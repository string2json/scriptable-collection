{
  "always_run_in_app": false,
  "icon": {
    "color": "deep-green",
    "glyph": "bolt"
  },
  "name": "南网在线_Pro",
  "script": "// Variables used by Scriptable.\n// These must be at the very top of the file. Do not edit.\n// icon-color: deep-green; icon-glyph: bolt;\n/**\n * 南网在线 Pro - 极简版\n * 独立 Scriptable 组件,不依赖远程模块\n * \n * 依赖数据:SouthernPower_95598.plugin 获取的 x-auth-token\n * 未配置 BoxJs 时可在 Scriptable 运行时手动粘贴 token\n */\n\n// ============ 基础配置 ============\nconst CACHE_KEY = 'nwg_token';\nconst fm = FileManager.local();\nconst cacheDir = fm.joinPath(fm.documentsDirectory(), 'nwg_cache');\nif (!fm.fileExists(cacheDir)) fm.createDirectory(cacheDir);\n\n// ============ 读取 Token ============\nlet token = args.widgetParameter || fm.readString(fm.joinPath(cacheDir, 'token.txt'));\n\n// BoxJs 中转\nif (!token) {\n  try {\n    const box = await new Request('http://boxjs.com/query/data/token_95598').loadJSON();\n    if (box && box.val) token = box.val;\n  } catch (e) {}\n}\n\n// 弹窗让用户填\nif (!token) {\n  const alert = new Alert();\n  alert.title = '南网在线 Pro';\n  alert.message = '未检测到 token。请先在 Loon 中运行 SouthernPower_95598.plugin 获取 token,或手动粘贴:';\n  alert.addTextField('x-auth-token', '');\n  alert.addAction('保存并运行');\n  alert.addCancelAction('取消');\n  const idx = await alert.presentAlert();\n  if (idx === -1) Script.exit();\n  token = alert.textFieldValue(0).trim();\n  if (token) fm.writeString(fm.joinPath(cacheDir, 'token.txt'), token);\n  else Script.exit();\n}\n\n// ============ API 封装 ============\nconst NWG_API = 'https://95598.csg.cn/ucs/ma/zt';\n\nasync function nwgRequest(path, body) {\n  try {\n    const req = new Request(NWG_API + path);\n    req.method = 'POST';\n    req.headers = {\n      'Content-Type': 'application/json',\n      'x-auth-token': token,\n    };\n    req.body = JSON.stringify(body || {});\n    const json = await req.loadJSON();\n    if (json.sta === '00' || json.sta === 0) return json.data;\n    return null;\n  } catch (e) {\n    console.log('API 请求失败: ' + path, e);\n    return null;\n  }\n}\n\n// ============ 数据获取 ============\nasync function fetchData() {\n  const start = Date.now();\n  \n  const eleUsers = await nwgRequest('/eleCustNumber/queryBindEleUsers', {});\n  if (!eleUsers || eleUsers.length === 0) return null;\n  const user = eleUsers[0];\n  const { eleCustId, areaCode } = user;\n  \n  const [balanceData, billData, yearBillData] = await Promise.all([\n    nwgRequest('/charge/queryUserAccountNumberSurplus', { eleCustId, areaCode }),\n    nwgRequest('/charge/queryBillOverview', { eleCustId, areaCode }),\n    nwgRequest('/charge/selectElecBill', { \n      electricityBillYear: new Date().getFullYear(), \n      areaCode, \n      eleCustId \n    }),\n  ]);\n  \n  const balance = balanceData && balanceData[0] ? parseFloat(balanceData[0].balance || 0) : 0;\n  const bills = (billData && billData.billOverviewModelList) || [];\n  const lastBill = bills.find(b => b.electricityBillYearMonth && b.readingDate);\n  const prevBill = bills[1] || lastBill;\n  const yearBills = (yearBillData && yearBillData.lsEleBill) || [];\n  const yearTotal = yearBills.reduce((s, b) => s + parseFloat(b.totalElectricity || 0), 0);\n  const yearAmount = yearBills.reduce((s, b) => s + parseFloat(b.totalAmount || 0), 0);\n  const lastPower = lastBill ? parseFloat(lastBill.totalElectricity || 0) : 0;\n  const lastAmount = lastBill ? parseFloat(lastBill.totalAmount || 0) : 0;\n  const prevPower = prevBill ? parseFloat(prevBill.totalElectricity || 0) : 0;\n  const prevAmount = prevBill ? parseFloat(prevBill.totalAmount || 0) : 0;\n  \n  const monthData = Array(12).fill(0);\n  bills.forEach(b => {\n    if (b.electricityBillYearMonth) {\n      const m = parseInt(b.electricityBillYearMonth.substring(4, 6), 10);\n      if (m >= 1 && m <= 12) monthData[m - 1] = parseFloat(b.totalElectricity || 0);\n    }\n  });\n  \n  console.log('数据获取耗时:' + (Date.now() - start) + 'ms');\n  return {\n    balance, prevBalance: 0,\n    lastPower, lastAmount, prevPower, prevAmount,\n    yearTotal, yearAmount, monthData,\n    eleCustId, areaCode,\n    custName: user.custName || '用户',\n  };\n}\n\n// ============ 梯度电价 ============\nfunction getTierInfo(power) {\n  const m = new Date().getMonth() + 1;\n  const isSummer = m >= 4 && m <= 10;\n  const tiers = isSummer\n    ? [{ limit: 220, name: '第一档' }, { limit: 400, name: '第二档' }, { limit: Infinity, name: '第三档' }]\n    : [{ limit: 170, name: '第一档' }, { limit: 280, name: '第二档' }, { limit: Infinity, name: '第三档' }];\n  for (let i = 0; i < tiers.length; i++) {\n    if (power <= tiers[i].limit) {\n      const prev = i === 0 ? 0 : tiers[i - 1].limit;\n      const range = tiers[i].limit - prev;\n      const pct = ((power - prev) / range * 100).toFixed(1);\n      return { tier: tiers[i].name, pct: Math.min(100, pct) };\n    }\n  }\n  return { tier: '第三档', pct: 100 };\n}\n\n// ============ 柱状图 ============\nfunction drawBarChart(data, family) {\n  const width = family === 'accessoryRectangular' ? 52 : 180;\n  const height = family === 'accessoryRectangular' ? 28 : 60;\n  const ctx = new DrawContext();\n  ctx.size = new Size(width, height);\n  ctx.opaque = false;\n  const max = Math.max(...data, 1);\n  const count = data.length;\n  const barGap = family === 'accessoryRectangular' ? 1 : 3;\n  const barWidth = (width - barGap * (count - 1)) / count;\n  const colors = [\n    new Color('#3B82F6'), new Color('#10B981'), new Color('#F59E0B'),\n    new Color('#EF4444'), new Color('#8B5CF6'), new Color('#EC4899'),\n  ];\n  data.forEach((v, i) => {\n    const barH = Math.max(2, (v / max) * (height - 2));\n    const x = i * (barWidth + barGap);\n    const y = height - barH;\n    ctx.setFillColor(colors[i % colors.length]);\n    ctx.fillRect(new Rect(x, y, barWidth, barH));\n  });\n  return ctx.getImage();\n}\n\n// ============ 渲染 ============\nasync function render() {\n  const family = config.widgetFamily;\n  const data = await fetchData();\n  const w = new ListWidget();\n  w.setPadding(14, 16, 14, 16);\n  \n  if (!data) {\n    const err = w.addText('⚠️ 数据获取失败,检查 token');\n    err.font = Font.regularSystemFont(13);\n    return w;\n  }\n  \n  if (family === 'accessoryRectangular') {\n    const chart = drawBarChart(data.monthData.slice(-6), family);\n    const topRow = w.addStack();\n    topRow.layoutHorizontally();\n    topRow.spacing = 8;\n    topRow.addImage(chart).imageSize = new Size(50, 28);\n    const textCol = topRow.addStack();\n    textCol.layoutVertically();\n    textCol.addText('余额').font = Font.regularSystemFont(9);\n    const bal = w.addText('¥' + data.balance.toFixed(2));\n    bal.font = Font.boldSystemFont(22);\n    return w;\n  }\n  \n  // Medium\n  const topRow = w.addStack();\n  topRow.layoutHorizontally();\n  const balCol = topRow.addStack();\n  balCol.layoutVertically();\n  balCol.addText('剩余电费').font = Font.regularSystemFont(11);\n  balCol.textColor = Color.gray();\n  const balText = balCol.addText('¥' + data.balance.toFixed(2));\n  balText.font = Font.boldSystemFont(26);\n  topRow.addSpacer();\n  \n  const gridCol = topRow.addStack();\n  gridCol.layoutVertically();\n  gridCol.spacing = 4;\n  const makeCard = (label, value) => {\n    const s = gridCol.addStack();\n    s.layoutHorizontally();\n    s.spacing = 12;\n    s.addText(label).font = Font.regularSystemFont(9);\n    s.addText(value).font = Font.semiboldSystemFont(13);\n  };\n  makeCard('上期电费', '¥' + data.prevAmount.toFixed(2));\n  makeCard('上期电量', data.prevPower.toFixed(1) + '°');\n  makeCard('年度电费', '¥' + data.yearAmount.toFixed(2));\n  makeCard('年度电量', data.yearTotal.toFixed(1) + '°');\n  \n  w.addSpacer(10);\n  const bottomRow = w.addStack();\n  bottomRow.layoutHorizontally();\n  bottomRow.spacing = 10;\n  const chart = drawBarChart(data.monthData, family);\n  const chartStack = bottomRow.addStack();\n  chartStack.layoutVertically();\n  chartStack.addImage(chart);\n  chartStack.addSpacer(2);\n  chartStack.addText('近12个月').font = Font.regularSystemFont(8);\n  chartStack.textColor = Color.gray();\n  \n  const tier = getTierInfo(data.lastPower);\n  const progStack = bottomRow.addStack();\n  progStack.layoutVertically();\n  progStack.addText(tier.tier + '  ' + tier.pct + '%').font = Font.regularSystemFont(10);\n  const barBg = progStack.addStack();\n  barBg.size = new Size(120, 8);\n  barBg.backgroundColor = new Color('#E0E0E0');\n  barBg.cornerRadius = 4;\n  const barFill = barBg.addStack();\n  barFill.size = new Size(parseFloat(tier.pct) * 1.2, 8);\n  barFill.backgroundColor = tier.tier === '第一档' ? new Color('#22C55E') \n    : tier.tier === '第二档' ? new Color('#F59E0B') \n    : new Color('#EF4444');\n  barFill.cornerRadius = 4;\n  return w;\n}\n\ntry {\n  const widget = await render();\n  if (config.runsInWidget) Script.setWidget(widget);\n  else widget.presentMedium();\n} catch (e) {\n  console.log('渲染失败:', e);\n  const w = new ListWidget();\n  w.addText('❌ 渲染失败: ' + e.message).font = Font.regularSystemFont(13);\n  if (config.runsInWidget) Script.setWidget(w);\n  else w.presentMedium();\n}\nScript.complete();\n",
  "share_sheet_inputs": []
}