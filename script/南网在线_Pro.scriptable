{
  "always_run_in_app": false,
  "icon": {
    "color": "deep-green",
    "glyph": "bolt"
  },
  "name": "南网在线_Pro",
  "script": "// Variables used by Scriptable.\n// These must be at the very top of the file. Do not edit.\n// icon-color: deep-green; icon-glyph: bolt;\n/**\n * 南网在线 Pro v2\n * 独立 Scriptable 组件\n * 使用前:手动从 Loon 通知复制 token,粘贴到脚本里或运行时弹窗输入\n */\n\nconst fm = FileManager.local();\nconst cacheDir = fm.joinPath(fm.documentsDirectory(), 'nwg_cache');\nif (!fm.fileExists(cacheDir)) fm.createDirectory(cacheDir);\nconst tokenFile = fm.joinPath(cacheDir, 'token.txt');\n\n// ============ 获取 Token ============\nlet token = args.widgetParameter || (fm.fileExists(tokenFile) ? fm.readString(tokenFile) : '');\n\nif (!token) {\n  const alert = new Alert();\n  alert.title = '🔑 需要南网 Token';\n  alert.message = '获取方法:\\n1. Loon 开 SouthernPower_95598.plugin\\n2. 打开南网 App/小程序\\n3. Loon 通知栏\"95598_Token获取成功\" → 点通知复制 token\\n4. 粘贴到下方';\n  alert.addTextField('粘贴 x-auth-token', '');\n  alert.addAction('保存并运行');\n  alert.addCancelAction('取消');\n  const idx = await alert.presentAlert();\n  if (idx === -1) Script.exit();\n  token = alert.textFieldValue(0).trim();\n  if (token) fm.writeString(tokenFile, token);\n  else Script.exit();\n}\nconsole.log('✅ Token 已加载,长度=' + token.length);\n\n// ============ API ============\nconst HOSTS = [\n  'https://95598.csg.cn/ucs/ma/zt',\n  'https://weixin.csg.cn/ucs/ma/wx-api',\n];\n\nasync function tryRequest(path, body) {\n  let lastErr = null;\n  for (const host of HOSTS) {\n    try {\n      const url = host + path;\n      console.log('📡 请求: ' + url);\n      const req = new Request(url);\n      req.method = 'POST';\n      req.timeoutInterval = 10;\n      req.headers = {\n        'Content-Type': 'application/json;charset=UTF-8',\n        'Accept': 'application/json, text/plain, */*',\n        'Origin': host.replace(/\\/ucs.*$/, ''),\n        'Referer': host.replace(/\\/ucs.*$/, '') + '/',\n        'x-auth-token': token,\n        'User-Agent': 'Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X)',\n      };\n      req.body = JSON.stringify(body || {});\n      const resp = await req.load();\n      const text = new TextDecoder().decode(resp);\n      console.log('📥 响应(' + url + '): ' + text.substring(0, 300));\n      try {\n        const json = JSON.parse(text);\n        return { host, json };\n      } catch (e) {\n        return { host, json: null, raw: text };\n      }\n    } catch (e) {\n      console.log('❌ ' + host + ' 失败: ' + e.message);\n      lastErr = e;\n    }\n  }\n  throw lastErr || new Error('所有域名请求失败');\n}\n\n// ============ 数据获取 ============\nasync function fetchData() {\n  // 1. 查户号\n  const users = await tryRequest('/eleCustNumber/queryBindEleUsers', {});\n  if (!users.json) {\n    console.log('❌ queryBindEleUsers 无 JSON 响应');\n    return null;\n  }\n  \n  // 不同 host 返回格式不同,兼容处理\n  let eleUsers = null;\n  if (Array.isArray(users.json)) {\n    eleUsers = users.json;\n  } else if (users.json.data && Array.isArray(users.json.data)) {\n    eleUsers = users.json.data;\n  } else if (users.json.data && users.json.data.lsBindEleUser) {\n    eleUsers = users.json.data.lsBindEleUser;\n  } else if (users.json.lsBindEleUser) {\n    eleUsers = users.json.lsBindEleUser;\n  }\n  \n  if (!eleUsers || eleUsers.length === 0) {\n    console.log('❌ 未找到绑定户号,完整响应: ' + JSON.stringify(users.json).substring(0, 500));\n    return null;\n  }\n  \n  console.log('✅ 找到 ' + eleUsers.length + ' 个户号');\n  const user = eleUsers[0];\n  const eleCustId = user.eleCustId || user.custId;\n  const areaCode = user.areaCode;\n  console.log('户号: eleCustId=' + eleCustId + ', areaCode=' + areaCode);\n  \n  // 2. 余额\n  let balance = 0;\n  try {\n    const bal = await tryRequest('/charge/queryUserAccountNumberSurplus', { eleCustId, areaCode });\n    if (bal.json && Array.isArray(bal.json) && bal.json[0]) {\n      balance = parseFloat(bal.json[0].balance || bal.json[0].surplus || 0);\n    } else if (bal.json && bal.json.data && Array.isArray(bal.json.data) && bal.json.data[0]) {\n      balance = parseFloat(bal.json.data[0].balance || bal.json.data[0].surplus || 0);\n    }\n  } catch (e) { console.log('余额请求失败(可忽略): ' + e.message); }\n  \n  console.log('💰 余额: ' + balance);\n  \n  // 3. 账单概览\n  let bills = [];\n  try {\n    const bill = await tryRequest('/charge/queryBillOverview', { eleCustId, areaCode });\n    if (bill.json && bill.json.data && Array.isArray(bill.json.data.billOverviewModelList)) {\n      bills = bill.json.data.billOverviewModelList;\n    } else if (bill.json && Array.isArray(bill.json)) {\n      bills = bill.json;\n    }\n  } catch (e) { console.log('账单请求失败(可忽略): ' + e.message); }\n  \n  const lastBill = bills.find(b => b.totalElectricity);\n  const prevBill = bills[1] || lastBill;\n  \n  const lastPower = lastBill ? parseFloat(lastBill.totalElectricity || 0) : 0;\n  const lastAmount = lastBill ? parseFloat(lastBill.totalAmount || 0) : 0;\n  const prevPower = prevBill ? parseFloat(prevBill.totalElectricity || 0) : 0;\n  const prevAmount = prevBill ? parseFloat(prevBill.totalAmount || 0) : 0;\n  \n  const monthData = Array(12).fill(0);\n  bills.forEach(b => {\n    if (b.electricityBillYearMonth) {\n      const m = parseInt(b.electricityBillYearMonth.substring(4, 6), 10);\n      if (m >= 1 && m <= 12) monthData[m - 1] = parseFloat(b.totalElectricity || 0);\n    }\n  });\n  \n  return { balance, lastPower, lastAmount, prevPower, prevAmount, monthData };\n}\n\n// ============ 梯度电价 ============\nfunction getTierInfo(power) {\n  const m = new Date().getMonth() + 1;\n  const isSummer = m >= 4 && m <= 10;\n  const tiers = isSummer\n    ? [{ limit: 220, name: '第一档' }, { limit: 400, name: '第二档' }, { limit: Infinity, name: '第三档' }]\n    : [{ limit: 170, name: '第一档' }, { limit: 280, name: '第二档' }, { limit: Infinity, name: '第三档' }];\n  for (let i = 0; i < tiers.length; i++) {\n    if (power <= tiers[i].limit) {\n      const prev = i === 0 ? 0 : tiers[i - 1].limit;\n      const range = tiers[i].limit - prev;\n      const pct = power === 0 ? 0 : ((power - prev) / range * 100).toFixed(1);\n      return { tier: tiers[i].name, pct: Math.min(100, pct) };\n    }\n  }\n  return { tier: '第三档', pct: 100 };\n}\n\n// ============ 柱状图 ============\nfunction drawBarChart(data, family) {\n  const width = family === 'accessoryRectangular' ? 52 : 180;\n  const height = family === 'accessoryRectangular' ? 28 : 60;\n  const ctx = new DrawContext();\n  ctx.size = new Size(width, height);\n  ctx.opaque = false;\n  const max = Math.max(...data, 1);\n  const count = data.length;\n  const barGap = family === 'accessoryRectangular' ? 1 : 3;\n  const barWidth = (width - barGap * (count - 1)) / count;\n  const colors = [\n    new Color('#3B82F6'), new Color('#10B981'), new Color('#F59E0B'),\n    new Color('#EF4444'), new Color('#8B5CF6'), new Color('#EC4899'),\n  ];\n  data.forEach((v, i) => {\n    const barH = Math.max(2, (v / max) * (height - 2));\n    const x = i * (barWidth + barGap);\n    const y = height - barH;\n    ctx.setFillColor(colors[i % colors.length]);\n    ctx.fillRect(new Rect(x, y, barWidth, barH));\n  });\n  return ctx.getImage();\n}\n\n// ============ 渲染 ============\nfunction buildErrorWidget(msg) {\n  const w = new ListWidget();\n  w.setPadding(16, 16, 16, 16);\n  w.addText('❌ ' + msg).font = Font.regularSystemFont(13);\n  const hint = w.addText('请在 Scriptable 日志面板查看详细错误');\n  hint.font = Font.regularSystemFont(11);\n  hint.textColor = Color.gray();\n  return w;\n}\n\nasync function render() {\n  const family = config.widgetFamily;\n  \n  let data = null;\n  try {\n    data = await fetchData();\n  } catch (e) {\n    console.log('❌ fetchData 异常:', e.message);\n    return buildErrorWidget('网络/API 错误: ' + e.message);\n  }\n  \n  if (!data) return buildErrorWidget('数据获取失败(查看日志)');\n  \n  const w = new ListWidget();\n  w.setPadding(14, 16, 14, 16);\n  \n  if (family === 'accessoryRectangular') {\n    const chart = drawBarChart(data.monthData.slice(-6), family);\n    const topRow = w.addStack();\n    topRow.layoutHorizontally();\n    topRow.spacing = 8;\n    topRow.addImage(chart).imageSize = new Size(50, 28);\n    const textCol = topRow.addStack();\n    textCol.layoutVertically();\n    textCol.addText('余额').font = Font.regularSystemFont(9);\n    const bal = w.addText('¥' + data.balance.toFixed(2));\n    bal.font = Font.boldSystemFont(22);\n    return w;\n  }\n  \n  // Medium\n  const topRow = w.addStack();\n  topRow.layoutHorizontally();\n  const balCol = topRow.addStack();\n  balCol.layoutVertically();\n  balCol.addText('剩余电费').font = Font.regularSystemFont(11);\n  balCol.textColor = Color.gray();\n  const balText = balCol.addText('¥' + data.balance.toFixed(2));\n  balText.font = Font.boldSystemFont(26);\n  topRow.addSpacer();\n  \n  const gridCol = topRow.addStack();\n  gridCol.layoutVertically();\n  gridCol.spacing = 4;\n  const makeCard = (label, value) => {\n    const s = gridCol.addStack();\n    s.layoutHorizontally();\n    s.spacing = 12;\n    s.addText(label).font = Font.regularSystemFont(9);\n    s.addText(value).font = Font.semiboldSystemFont(13);\n  };\n  makeCard('上期电费', '¥' + data.prevAmount.toFixed(2));\n  makeCard('上期电量', data.prevPower.toFixed(1) + '°');\n  \n  w.addSpacer(10);\n  const bottomRow = w.addStack();\n  bottomRow.layoutHorizontally();\n  bottomRow.spacing = 10;\n  const chart = drawBarChart(data.monthData, family);\n  const chartStack = bottomRow.addStack();\n  chartStack.layoutVertically();\n  chartStack.addImage(chart);\n  chartStack.addSpacer(2);\n  chartStack.addText('近12个月').font = Font.regularSystemFont(8);\n  chartStack.textColor = Color.gray();\n  \n  const tier = getTierInfo(data.lastPower);\n  const progStack = bottomRow.addStack();\n  progStack.layoutVertically();\n  progStack.addText(tier.tier + '  ' + tier.pct + '%').font = Font.regularSystemFont(10);\n  const barBg = progStack.addStack();\n  barBg.size = new Size(120, 8);\n  barBg.backgroundColor = new Color('#E0E0E0');\n  barBg.cornerRadius = 4;\n  const barFill = barBg.addStack();\n  barFill.size = new Size(parseFloat(tier.pct) * 1.2, 8);\n  barFill.backgroundColor = tier.tier === '第一档' ? new Color('#22C55E') \n    : tier.tier === '第二档' ? new Color('#F59E0B') \n    : new Color('#EF4444');\n  barFill.cornerRadius = 4;\n  return w;\n}\n\ntry {\n  const widget = await render();\n  if (config.runsInWidget) Script.setWidget(widget);\n  else widget.presentMedium();\n} catch (e) {\n  console.log('❌ render 异常:', e);\n  const w = new ListWidget();\n  w.addText('❌ ' + e.message).font = Font.regularSystemFont(13);\n  if (config.runsInWidget) Script.setWidget(w);\n  else w.presentMedium();\n}\nScript.complete();\n",
  "share_sheet_inputs": []
}